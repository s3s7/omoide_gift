<turbo-frame id="ai-chat">
  <% if @error %>
    <p class="text-sm text-red-500 mb-3"><i class="fas fa-exclamation-triangle mr-1"></i><%= @error %></p>
  <% end %>

  <% if @answer %>
    <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 mb-3 text-sm text-gray-800 whitespace-pre-wrap">
      <i class="fas fa-robot text-blue-400 mr-1"></i><%= @answer %>
    </div>

    <% if @records.any? %>
      <div class="mb-3">
        <p class="text-xs text-gray-500 mb-1">参照した記録</p>
        <% @records.each do |r| %>
          <%= link_to gift_record_path(r), class: "block text-xs text-blue-600 hover:underline truncate" do %>
            ・<%= r.item_name %><%= r.gift_person ? "（#{r.gift_person.name}）" : "" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= form_with url: ai_chat_path, method: :post, data: { turbo_frame: "ai-chat" } do |f| %>
    <div class="flex gap-2">
      <%= f.text_field :query,
          value: "",
          placeholder: "例：田中さんに誕生日で今まで贈ったことがないプレゼントを贈りたいです。何かアイディアはありますか",
          class: "flex-1 text-sm border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-300 text-black" %>
      <%= f.submit "送信",
          data: { turbo_submits_with: "送信中..." },
          class: "bg-blue-500 text-white text-sm px-4 py-2 rounded-lg hover:bg-blue-600 cursor-pointer" %>
    </div>
  <% end %>
</turbo-frame>
