{
  "enabledMcpjsonServers": [
    "serena"
  ],
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git add*)",
            "command": "jq -r '.tool_input.command' | { read -r cmd; docker compose exec -T web bin/rubocop -a 2>/dev/null || true; }",
            "timeout": 60,
            "statusMessage": "RuboCop 自動整形中..."
          }
        ]
      }
    ]
  }
}